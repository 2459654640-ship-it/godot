extends SceneTree
const Story=preload("res://scripts/story.gd")
const District=preload("res://scripts/east_district.gd")
const Store=preload("res://scripts/save_store.gd")
var checks=0
var failures=0
var w
func _initialize():call_deferred("run")
func check(ok:bool,why:String):
 checks+=1
 if not ok:failures+=1;push_error(why)
func frames(n:int=4):
 for i in n:await physics_frame
func stop_world():
 w.set_physics_process(false);w.player.set_physics_process(false);w.combat.set_physics_process(false)
 for npc in w.npcs.values():npc.set_physics_process(false)
 w.story.flags.intro_done=true;w.story.flags.comic={"active":false};w.hud.comic_active=false;w.hud.close()
func act(key:String):
 w.story.act("c_"+key);check(w.story.last_action_valid,"action available: "+key)
func capsule_clear(p:Vector3)->bool:
 var shape=CapsuleShape3D.new();shape.radius=.30;shape.height=1.7
 var q=PhysicsShapeQueryParameters3D.new();q.shape=shape;q.collision_mask=1;q.transform=Transform3D(Basis.IDENTITY,p+Vector3.UP*.90)
 return w.get_world_3d().direct_space_state.intersect_shape(q).is_empty()
func reach()->Dictionary:
 var nav=w.navigation;var start=nav.graph.get_closest_point(Vector2(w.player.position.x,w.player.position.z));var seen={start:true};var queue=[start];var i=0
 while i<queue.size():
  var p=queue[i];i+=1
  for next in nav.graph.get_point_connections(p):
   if not seen.has(next):seen[next]=true;queue.append(next)
 return seen
func target_reached(id:String,seen:Dictionary)->bool:
 var nav=w.navigation;var t:Vector3=w.targets[id].pos
 for p in nav.points:
  if seen.has(p) and nav.points[p].distance_to(Vector2(t.x,t.z))<1.5:return true
 return false
func reader():
 var n=0
 while n<35:
  while current_scene==null:await process_frame
  w=current_scene
  if not w.story.flags.get("comic",{}).get("active",false):break
  var p:Dictionary=w.story.Comic.panel(w.story);check(not p.is_empty() and ResourceLoader.exists("res://assets/cinematics/"+p.art+".png"),"physical travel has matching illustration")
  w.hud.comic_choose(0 if p.has("choices") else -1);await frames();n+=1
 check(n<35,"travel finishes without a scene loop")
 w=current_scene;stop_world()
func run():
 w=load("res://scenes/east_district.tscn").instantiate();root.add_child(w);current_scene=w;await frames();stop_world();w.story.route="hatch";w.story.flags.departure_committed=true;w.story.flags.d6_wanted=true;w.story.flags.east_home="commune";w.story.give("mask");w.story.give("filter");w.story.give("revolver")
 check(w.navigation.graph.get_point_count()>12000 and w.navigation.graph.get_point_count()<48000,"district navigation covers the authored area within bounded graph size")
 check(w.targets.size()>=17 and w.public_radio!=null and w.combat.enabled,"district contains entrances, exploration targets, a receiver and working combat")
 check(w.player.art_id=="ivan_masked","outdoor Ivan uses the approved masked atlas")
 for entrance in District.layout().entrances:
  var a=entrance.arrival
  check(capsule_clear(Vector3(a[0],.04,a[1])),"arrival does not overlap door, wall or furniture: "+entrance.id)
 var seen=reach()
 for id in ["east_board","east_supply","east_spares","east_relay","east_shelter","east_waterworks_entry","east_pump_entry","east_transfer_entry","east_d6_entry","east_mine_entry"]:
  check(target_reached(id,seen),"western objective has a reachable interaction approach: "+id)
 for id in ["east_sech_entry","east_camp_cache","east_north_entry"]:check(not target_reached(id,seen),"locked crossing physically separates eastern objective: "+id)
 w.story.act("c_east_power_restore");check(not w.story.last_action_valid and not w.story.f("east_power_restored"),"power cannot skip the diagnosed fault and matching component")
 act("east_read_routes");act("east_take_supply");var ammo=w.story.economy.handmade
 w.story.act("c_east_take_supply");check(not w.story.last_action_valid and ammo==w.story.economy.handmade,"emergency supplies cannot be generated by repeated interaction")
 act("east_take_spares");var material=w.story.economy.goods.scrap_metal;w.story.act("c_east_take_spares");check(not w.story.last_action_valid and material==w.story.economy.goods.scrap_metal,"authored component cache is persistent and single use")
 w.story.act("c_east_make_bandage");check(not w.story.last_action_valid,"workshop requires restored power")
 var closed=w.campaign_gate.position;act("east_power_restore");check(w.campaign_gate.position.distance_to(closed)<.1,"powered door starts an animation instead of disappearing")
 await frames(90);check(w.campaign_gate.position.z>17 and w.get_node("EastWorkshopLamp").visible,"door slides along its fence and workshop visibly powers on")
 seen=reach()
 for id in ["east_sech_entry","east_camp_cache","east_north_entry"]:check(target_reached(id,seen),"restoring power opens a physical approach: "+id)
 var cloth=w.story.economy.goods.salvage_cloth;var medicine=w.story.economy.goods.bandage
 act("east_make_bandage");check(w.story.economy.goods.salvage_cloth==cloth-2 and w.story.economy.goods.bandage==medicine+1,"crafting consumes exact materials and adds one real usable item")
 act("east_make_cord");check(w.story.economy.goods.cord==1,"workbench provides a second distinct recipe")
 var funds=w.story.economy.military;w.story.Economy.sell(w.story,"copper_wire");check(w.story.economy.military==funds+3,"new material can actually be sold at its disclosed price")
 for id in ["scrap_metal","copper_wire","salvage_cloth"]:check(ResourceLoader.exists(w.hud.item_icon(id)),"new material has a valid existing-style inventory icon: "+id)
 w.story.act("c_east_enter_sech");check(not w.story.last_action_valid,"walking to the other faction cannot bypass its contact cost")
 w.story.flags.cross_contact_ready=true;act("east_enter_sech");check(not w.story.f("cross_contact_ready") and int(w.story.flags.cross_contact_trips)==1,"actual crossing consumes the prepared visit once")
 w.story.act("c_east_enter_sech");check(not w.story.last_action_valid,"spent contact cannot be reused")
 w.story.flags.coal_access=true;w.story.act("c_east_enter_labor");check(not w.story.last_action_valid and not w.story.Chapter.home_access(w.story),"a deserter's old mine stamp grants neither public entry nor home access")
 w.story.act("c_east_take_north");check(not w.story.last_action_valid,"restored power alone does not grant Star City access")
 var encounters=District.encounters(w.story);check(encounters==District.encounters(w.story),"population layout is deterministic for the saved batch")
 w.combat.begin("east_road")
 for enemy in w.combat.enemies:enemy.set_physics_process(false)
 check(w.combat.enemies.any(func(e):return e.enemy_kind=="pouncer"),"road encounter uses animated creatures with distinct attacks")
 for enemy in w.combat.enemies.duplicate():enemy.damage(1000)
 check(w.story.f("battle_east_road") and w.story.flags.east_loot.size()==2,"creature drops and clear state persist in district-specific records")
 var key=w.story.flags.east_loot.keys()[0];var loot="east_loot_"+key;w.player.position=w.targets[loot].pos;var good:String=w.story.flags.east_loot[key].good;var count=int(w.story.economy.goods.get(good,0));District.collect(w,loot);District.collect(w,loot)
 check(int(w.story.economy.goods[good])==count+1 and w.story.flags.east_loot[key].taken,"loot interaction cannot duplicate a taken resource")
 w.story.context.camp_loot_safe=true;act("east_open_cache");var snapshot=w.save_snapshot();check(Store.valid(snapshot),"normal save schema accepts the new floor and all resource state")
 var restored=Story.new();restored.restore(JSON.parse_string(JSON.stringify(snapshot)));check(restored.f("east_power_restored") and restored.flags.east_loot[key].taken,"load retains permanent power and collected loot")
 w.arrival_data=snapshot.duplicate(true);w.played_seconds+=901;District.prepare(w);check(w.story.f("battle_east_road"),"loading a save does not repopulate the scene")
 w.arrival_data.floor="commune";District.prepare(w);check(not w.story.f("battle_east_road") and int(w.story.flags.east_spawn_batches.east_road)==1,"a later journey may start one new batch after sufficient played time")
 District.prepare(w);check(int(w.story.flags.east_spawn_batches.east_road)==1 and w.story.f("east_cache_taken"),"refresh does not duplicate batches or reset authored rewards")
 # Private visit is prepared through actual known NPC options and never washes the wanted identity.
 var s=Story.new();s.route="hatch";s.context.floor="commune";s.flags.anna_request=true;s.flags.anna_records=true;s.flags.first_meeting_commune_printer=2
 s.act("c_east_mine_contact");check(s.last_action_valid and s.f("east_mine_contact_known") and not s.f("east_mine_prepared"),"contact introduces a specific person without granting immediate entry")
 s.act("c_east_mine_prepare");check(s.last_action_valid and s.f("east_mine_prepared"),"preparation records entrance and return arrangements")
 s.context.floor="east_district";s.act("c_east_enter_mine");check(s.last_action_valid and s.flags.next_sequence=="east_mine_approach","prepared visit reaches a private entrance, not the D-6 desk")
 s.Comic.start(s,"east_mine_approach");s.Comic.choose(s,1);s.Comic.choose(s);check(s.flags.next_facility=="east_district" and not s.f("east_private_mine_entry"),"withdrawing from the entrance grants no admission or punishment")
 s.Comic.start(s,"east_mine_approach");s.Comic.choose(s,0);s.Comic.choose(s);check(s.flags.next_facility=="coal" and District.private_mine(s) and not s.Campaign.Access.public_entry(s),"waiting for the contact enters only coal without public permission")
 s.context.floor="coal";check(s.view("coal_clerk").name.contains("瓦西里") and not s.view("coal_clerk").body.contains("准入页"),"private contact uses his own dialogue rather than public permit fiction")
 s.act("c_coal_register");check(s.last_action_valid,"private arrival still permits the identity investigation")
 s.act("c_coal_return");check(s.last_action_valid and s.flags.next_sequence=="east_return_coal","private departure returns through the service entrance, never D-6 proper")
 s.flags.anna_request=true;s.flags.brother_found=true;s.context.floor="east_district"
 var follow=preload("res://scripts/journal.gd").tasks(s).filter(func(t):return t.id=="anna")[0]
 check(follow.place=="east_district" and follow.target=="east_commune_entry","Anna's return objective points to the current outdoor exit rather than a missing indoor NPC")
 # Actual UI travel: leave the outdoor district, enter the old pump scene and return to the same doorway.
 w.story.flags.east_home="commune";w.story.flags.east_trip_active=true;w.story.flags.surface_from_commune=true;w.story.flags.comic={"active":false};w.hud.comic_active=false;w.hud.close()
 w.perform("c_east_enter_surface","east_pump_entry");await reader();check(w.floor_id=="surface","real interaction reaches the retained independent pump map")
 w.perform("c_surface_back_commune","surface_exit");await reader();check(w.floor_id=="east_district" and w.player.position.distance_to(Vector3(-31,.04,-14))<1.5,"pump exit returns to its physical outdoor entrance")
 check(w.story.f("east_power_restored") and w.story.flags.east_loot[key].taken and not w.targets.has(loot),"cross-map return preserves unlocked roads and single-use resources")
 w.combat.clip=3;w.combat.sync();w.perform("c_east_enter_commune","east_commune_entry");await reader()
 check(w.floor_id=="commune" and int(w.save_snapshot().flags.weapon_clip)==3,"saving in a peaceful interior does not refill a partially loaded weapon")
 w.perform("c_east_depart_commune","commune_leave");await reader()
 check(w.floor_id=="east_district" and w.combat.clip==3,"returning from the settlement retains the exact loaded ammunition")
 w.queue_free();await frames()
 print("EAST_DISTRICT_V27_RESULT checks=",checks," failures=",failures);quit(0 if failures==0 else 1)
