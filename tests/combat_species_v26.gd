extends "res://tests/enemy_routes_v23.gd"
func run():
 arena();grid();w.player.position=Vector3(0,.04,2.5)
 var e=spawn(Vector3(0,.04,0),"pouncer");await frames(2)
 check(e.windup>.8 and is_instance_valid(e.warning),"pouncer visibly warns for a dodgeable interval before moving")
 check(e.sprite.vframes==7 and e.sprite.frame/5==3,"pouncer uses authored crouching animation")
 var old_direction=e.attack_direction;w.player.position=Vector3(2.5,.04,2.5);await frames(60)
 check(e.attack_direction==old_direction and w.story.economy.health==10000,"pounce locks its direction and can be sidestepped")
 await frames(35);check(e.recovery>0 or e.cooldown>0,"missed pounce has recovery rather than instant retarget")
 e.position=Vector3.ZERO;w.player.position=Vector3(0,.04,2);e.cooldown=0;e.recovery=0;e.charge_time=0;await frames(2)
 check(e.windup>0,"second pounce winds up")
 e.damage(1);await frames(2);check(e.windup==0 and e.recovery>0 and not is_instance_valid(e.warning),"actual shot interrupts windup and removes warning")
 e.set_physics_process(false);var state=e.attack_state();state.direction=[1,0,0];state.charge=.23;state.hit=true;e.restore_attack(state)
 check(e.attack_direction==Vector3.RIGHT and is_equal_approx(e.charge_time,.23) and e.charge_hit,"charge state retains heading, remaining duration and already-hit guard")
 await dispose()
 arena();grid();w.player.position=Vector3(0,.04,2)
 e=spawn(Vector3(0,.04,0),"pouncer");e.attack_direction=Vector3.BACK;e.charge_time=.42;e.cooldown=3
 await frames(30)
 check(w.story.economy.health==9988 and e.position.z>1,"pounce actually travels over floor and hits exactly once")
 await dispose()
 arena();w.kit.box("ChargeCover",Vector3(0,.6,0),Vector3(3,1.2,.2),"metal",true);grid()
 w.player.position=Vector3(0,.04,2);e=spawn(Vector3(0,.04,-1),"pouncer");e.attack_direction=Vector3.BACK;e.charge_time=.42;await frames(40)
 check(e.position.z<0 and w.story.economy.health==10000,"charge stops against solid cover")
 await dispose()
 arena();grid();w.player.position=Vector3(0,.04,2)
 var shot=director.launch_projectile(Vector3(0,.6,-2),Vector3.BACK);await frames(65)
 check(w.story.economy.health==9990 and not is_instance_valid(shot),"physical spit strikes player once and disappears")
 await dispose()
 arena();w.kit.box("SpitCover",Vector3(0,.7,0),Vector3(3,1.4,.2),"metal",true);grid();w.player.position=Vector3(0,.04,2)
 shot=director.launch_projectile(Vector3(0,.6,-2),Vector3.BACK);await frames(65)
 check(w.story.economy.health==10000 and not is_instance_valid(shot),"swept spit collision stops at cover without damage through wall")
 await dispose()
 arena();grid();w.player.position=Vector3(0,.04,2)
 shot=director.launch_projectile(Vector3(0,.6,-2),Vector3.BACK);w.player.position.x=2;await frames(75)
 check(w.story.economy.health==10000,"fixed spit trajectory can be dodged")
 await dispose()
 arena();grid();w.player.position=Vector3(0,.04,5);e=spawn(Vector3.ZERO,"spitter");await frames(2)
 check(e.windup>.9 and e.sprite.frame/5==3,"spitter inflates its throat during warning")
 await frames(59);check(director.projectiles.size()==1 and e.recovery>0,"spitter actually releases a moving projectile with attack pose")
 await dispose()
 # Real level: feedback and save/load must survive a flying projectile and a charge.
 w=load("res://scenes/waterworks.tscn").instantiate();root.add_child(w);current_scene=w;await frames(8)
 w.hud.close();w.story.flags.intro_done=true;w.set_physics_process(false);w.player.set_physics_process(false)
 director=w.combat;director.set_physics_process(false);director.veteran.set_physics_process(false)
 w.player.position=Vector3(-13,.04,-2);w.story.flags.plant_diagram=true;director.begin("pump")
 for enemy in director.enemies:enemy.set_physics_process(false)
 check(director.enemies.map(func(enemy):return enemy.enemy_kind)==["mutant","mutant","pouncer"],"first battle mixes old and new species without extra bullet sponges")
 e=director.enemies[2];e.attack_direction=Vector3.RIGHT;e.charge_time=.21;e.charge_hit=true;e.hp=31
 shot=director.launch_projectile(Vector3(-14,.6,-3),Vector3.RIGHT);shot.remaining=1.2;shot.set_physics_process(false)
 var snapshot=w.save_snapshot();var store=w.SaveStore
 check(store.write("user://species_roundtrip.json",snapshot)==OK,"new species and flying projectiles are accepted by real save writer")
 var loaded=store.read("user://species_roundtrip.json")
 check(not loaded.is_empty() and loaded.combat_state.projectiles.size()==1,"disk roundtrip retains in-flight state with checksum")
 var bad=snapshot.duplicate(true);bad.combat_state.projectiles[0].direction=[0,"bad",1]
 check(not store.valid(bad),"malformed new projectile data is rejected before restore")
 var saved=loaded.combat_state;director.restore_state(saved);await frames(1)
 for enemy in director.enemies:enemy.set_physics_process(false)
 for flying in director.projectiles:flying.set_physics_process(false)
 check(director.enemies[2].hp==31 and director.enemies[2].charge_hit and absf(director.enemies[2].charge_time-.21)<.02,"save restores charge duration, health and hit guard")
 check(director.projectiles.size()==1 and director.projectiles[0].remaining>1.15,"save restores actual in-flight projectile")
 e=director.enemies[0];var hits=director.confirmed_hits;e.damage(1,true)
 check(director.confirmed_hits==hits+1 and director.feedback.flashes.size()==1,"actual player hit produces explicit confirmation")
 var barrier=w.kit.box("FeedbackWall",Vector3(-13,.7,-3),Vector3(3,1.4,.2),"metal",true);e.position=Vector3(-13,.04,-5);await frames(3)
 w.toggle_weapon();director.aim=e.position+Vector3.UP*.62;director.cooldown=0;hits=director.confirmed_hits;director.shoot()
 check(director.confirmed_hits==hits,"hitting wall never reports a monster hit")
 shot=director.projectiles[0];var before=shot.position;var life=shot.remaining;w.hud.show_inventory();shot._physics_process(.5)
 check(shot.position==before and shot.remaining==life,"inventory pauses flying projectile as well as enemy attacks")
 w.hud.close();barrier.queue_free();w.queue_free();await frames()
 print("COMBAT_SPECIES_V26_RESULT checks=",checks," failures=",failures);quit(0 if failures==0 else 1)
