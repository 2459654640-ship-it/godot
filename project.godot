; Metro 1982 — narrative exploration
config_version=5

[application]
config/name="地铁1982 · D-6"
run/main_scene="res://scenes/d6.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="地铁1982 · 等距叙事探索、设施地图与图文旅程"

[autoload]
Session="*res://scripts/session.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.025,0.035,0.04,1)

[audio]
driver/enable_input=false
