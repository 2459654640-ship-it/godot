"supply_queue":["supply","「今天排队的人比平时多？」","「征召通知一贴出来，大家都担心以后的配给会变少。我解释了一早上，还是有人不放心。」\n柳德米拉理了理账页。\n「人们担心也有道理。只可惜粮食不在我笔下，改个数字，柜里也多不出来粮食。」"],
"supply_commander":["supply","「中尉来领过东西了吗？」","「天没亮就来了，问备用绷带够不够。」\n柳德米拉放低声音。\n「他这个人性子急，说话也冲，不过领东西时很仔细，整队人的装备都要一件件查过，不光顾着自己。」"],
"supply_semyon":["supply","「老爹这月的配给领了吗？」","「领了。走的时候还分给那个值夜班的小伙子一点面包。」\n她看着你。\n「有空回去看看他还剩多少吃的。他怕你操心，缺东西也不肯说。」"],
"commander_sleep":["commander","「你昨晚也在这里？」","「昨晚一直在核对出发名单，没睡好。」\n科瓦廖夫揉了揉眼角。\n「你今晚早点休息。到了地表，听漏一声提醒、慢半步，都可能出事。」"],
"commander_semyon":["commander","「老爹教过我机械知识，等出去了用得上吗？」","「用得上。检查线路、看懂压力表，到了水厂都要用。」\n科瓦廖夫收起清单。\n「不过那里的设备多年没人维护，先看值班图，拿不准就问我们，别直接动手。」"],
"commander_water":["commander","「大家都在问，我们的储水真的只够两周了吗？」","「是按现在的配给量算，最多两周，病房和食堂的用水也算在内。」\n科瓦廖夫看了看桌上的清单。\n「库存核过了，才贴的通知。听到什么拿不准的消息，可以来问我。」"],
"igor_cold":["igor","「这边风真大。还得守多久？」","「接班的人来之前，都算我的。」\n伊戈尔换了条腿站着，手在腰后按了一下。\n「门一开，冷气全往这里灌。你小时候总想探头看看，现在站这儿倒嫌冷了。」"],
"igor_mikhail":["igor","「米哈伊尔一早就在食堂。」","「昨晚盘库盘晚了吧。他一着急，饭都记不住吃。」\n伊戈尔把登记簿翻回原处。\n「要是回去碰见他，叫他把我的围巾还了。去年冬天借的，到现在没影。」"],
"igor_semyon":["igor","「你和老爹还有来往？」","「有，隔几天就来门口坐一会儿。他还给我送过自己泡的药酒，喝完身上热了半夜。」\n他嘴角动了一下。\n「前几天还见过，他问我的腰，我问他的咳嗽，谁也不肯承认自己老了。你也替我问候他。」"]
}

static func decorate(v:Dictionary,s) -> Dictionary:
	v.body=BODIES.get(v.id,v.body)
	if v.id=="nina":v.role="东段维修工"
	if v.id=="box":
		v.name="老爹房里的旧木箱"
		if s.f("cache"):v.body="木箱的底板已经掀开。下面只剩一个酒瓶压过的灰印，旧物也都收走了。"
		elif s.f("searched"):v.body="匕首、香烟和照片已经收好。你按了按箱底那块木板，另一端翘起来一点。下面果然是空的。"
	if v.id=="radio" and s.has("frequency"):v.body="你按纸上记下的刻度重新调了一遍。除了断断续续的电流声，什么也没听见。"
	if v.id=="chalk" and s.f("chalk"):v.body="墙上的星星和轨道还在。拓印收在你的手记里，旁边仍没有其他记号。"
	if v.id=="semyon" and s.f("accepted"):v.body="「和中尉说好了？」\n老爹看着你的背包，伸手替你抻平一条扭着的带子。\n「扣子也检查一遍。路上别离开队伍，面具不舒服就立即示意。我能叮嘱的也就这些……回来敲门，夜里我也听得见。」"
	if v.id=="cook" and s.f("valve"):
		v.body="加琳娜摸过接头，确认已经不漏水，便把接漏桶挪到一旁。\n「修好了，谢谢你。要领汤就拿个碗来。」"
		if s.f("soup_claimed"):v.body="「汤拿稳，碗记得带回来。」\n加琳娜已经在给下一班盛饭。接漏的桶空着，再没有滴水声。"
	if v.id=="valve" and s.f("valve"):v.body="接头已经拧紧。你用手指试了试，管壁是干的。下面的桶暂时用不上了。"
	if v.id=="cabinet" and s.f("fuse_taken"):v.body="断电柜的门已经打开。纸袋里最后一枚保险芯被你取走了，柜里只剩几截包着布皮的旧线。"
	if v.id=="relay" and s.f("relay"):v.body="电气读数稳定下来，与机械表的指针基本一致。你又看了一会儿，没有再跳动。"
	if v.id=="nina" and s.f("relay"):
		v.body="「回来了？读数刚才已经亮了。」\n妮娜把工具箱关上，取出登记簿。\n「你报一下换的规格，我把这单记完。」"
		if s.has("permit"):v.body="「许可拿好了，别和废纸折一块儿。」\n妮娜已经在整理下一张维修单。\n「出去前再试试面罩。工具带着吧，东段也用得上，回来还我就行。」"
	if v.id=="commander" and s.f("accepted"):v.body="「装备领齐了吗？」\n科瓦廖夫把你的名字从头到尾核对了一遍。\n「准备好了就去气闸，没办完的先去办。明早别让我挨个找人。」"
	if v.id=="supply" and s.f("kit"):v.body="柳德米拉把你签过的领用页夹回账簿。\n「面具和滤毒罐都领了。还有事？我先把这一页算完。」"
	if v.id=="mikhail" and s.f("shift"):v.body="「图收好，别落在这儿。」\n米哈伊尔压低声音。\n「换班看黄灯，走侧门。我能告诉你的就这些，剩下得你自己留神。」"
	if v.id=="igor" and s.f("gate"):v.body="「门开了，小心里面的台阶。」\n伊戈尔把登记簿合上，转身去看压力表。"
	if v.id=="gate" and s.f("gate"):v.body="门闩已经拉开。门后的冷风钻进领口，里面还能看见几盏微弱的灯。"
	if v.id=="side" and not s.f("shift"):v.body="压力表旁有一道窄门，门框上贴着褪色的检修标签。墙上亮着换班指示灯。\n门关着。单看这几盏灯，还摸不清岗哨的规律。"
	if v.id=="side" and s.f("side_crossed"):v.body="你已经绕过了岗哨。窄门在身后开着一条缝，走廊里的声音变得很远。"
	if v.id=="hatch" and s.f("hatch"):v.body="盖板已经移开，下面的管线通向岗哨后方。螺栓孔周围留下了新鲜的擦痕。"
	for o in v.options:
		o.text=OPTIONS.get(o.key,o.text)
		if o.key=="open_cache" and not s.f("searched"):o.reason="先翻查木箱"
		if o.key=="claim_soup" and s.f("soup_claimed"):o.reason="热汤已经领过了"
		if o.key=="claim_permit" and s.has("permit"):o.reason="检修许可已经放在背包里"
		if o.key in ["use_permit","use_vodka"] and s.f("gate"):o.reason="维修门已经打开"
	for key in CHAT:
		if CHAT[key][0]==v.id:v.options.append(s.opt(key,CHAT[key][1]))
	return v

static func reply(key:String,original:String) -> String:
	return REPLIES.get(key,original)
